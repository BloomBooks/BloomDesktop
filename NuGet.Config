<?xml version="1.0" encoding="utf-8"?>
<!--
  TEMPORARY, AND ONLY ON THIS BRANCH.

  BloomFreezeDoctor.Contract is not published anywhere yet - deliberately, because a push to a public
  feed cannot be undone and we want to review this shape first. So it is restored from a local folder,
  which you populate from a clone of the Doctor's repo:

      build/pack-contract-locally.ps1        (or .sh)

  When the package is published for real, this file and that script both go away and the feed becomes
  whichever feed we settle on. See BL-16719.

  Note: `<clear />` is deliberately absent, so nuget.org and any machine-level sources still apply -
  Bloom restores 53 other packages from them. This only ADDS a source.

  Note also that this lives at the repository root rather than in .nuget/. Modern NuGet walks up the
  directory tree looking for NuGet.Config and does not read the legacy .nuget/ location, so the
  existing .nuget/NuGet.Config is left alone; it is not where a new source would take effect.
-->
<configuration>
  <packageSources>
    <add key="local-freeze-doctor-contract" value="localpackages" />
  </packageSources>
</configuration>
