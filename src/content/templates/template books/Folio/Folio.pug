include ../standard-page-mixins.pug

//- A folio publishes other books of its collection as one book. The books it holds, and their order,
//- are named by the data-folio-book-ids of the list on its table of contents page
//- (Book.GetFolioBookIds); a book with such a page is a folio (Book.IsFolio). A folio has exactly
//- one: it is "required", so it cannot be deleted, duplicated or moved, and it cannot be copied
//- (Page.IsFolioTableOfContents). When the list is too long for the page, it flows on into pages
//- that Bloom adds and removes as needed (folioToc.ts). The list is an ordinary text box, so it can be
//- formatted; choosing the books rewrites its text, and so does making the PDF, which adds each
//- book's first page number.

//- The table of contents page: a heading, and the list of books.
mixin folio-toc-page
	+page('Table of Contents', 'Lists the books this folio publishes, in order.')&attributes(attributes)
		+field-prototypeDeclaredExplicity('V').bloom-folio-toc-heading.TableOfContentsHeading-style
			+editable(kLanguageForPrototypeOnly)
			+editable('en') Table of Contents
		+field('V').bloom-folio-toc-list.bloom-flowable.TableOfContents-style(data-folio-book-ids='')

doctype html
html
	head
		+metadata-standard
		meta(name='defaultNameForDerivedBooks', content='Folio')
		meta(name='bloomBookId', content='788fa287-ae9d-4176-9f75-e586e9157c09')
		meta(name='SuitableForMakingShells', content='yes')
		//- Eventually, we'll remove Bloom's need for this.
		meta(name='pageTemplateSource', content='Folio')
		title 'Folio'
		+stylesheets('Folio.css')
		+standardStyles
			= '\n'
			//- A style, not a size in Folio.less, so the Format dialog can change it. It must not be
			//- relative (em, %): Bloom copies the box's size onto its translation group each time the
			//- page is shown (SetupThingsSensitiveToStyleChanges), so a relative size grows every time.
			| .TableOfContentsHeading-style { font-size: 16pt !important; text-align: center !important; }
	body
		+dataDiv
			+bookVariable-title('en', 'Folio')
			+bookVariable('styleNumberSequence', '*', '0')
		+preview-outsideFrontCover
		+folio-toc-page.bloom-folio-toc#76b232bd-e619-4f7d-8fc9-3f01daf3d940(data-page='required')
