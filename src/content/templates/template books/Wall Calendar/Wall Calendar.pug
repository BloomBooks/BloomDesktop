doctype html
include ../standard-page-mixins.pug

//- This is an 'override' from bloom-foundation-mixins.pug
//- that allows us to use its mixins that would otherwise
//- put in a5portrait
mixin pageWithJustPageSize
	.A5Landscape&attributes(attributes)
		block

//- generates a translationGroup with any classes on the internal div
mixin field-classOnChild(internalClass)
	- requireOneArgument('field-classOnChild', arguments)
	.bloom-translationGroup&attributes(attributes)
		block
		+editable(kLanguageForPrototypeOnly)(class=internalClass)

mixin image-largePage
	- requireZeroArguments('image', arguments);
	.bloom-canvas.bloom-has-canvas-element(style="opacity: 1; overflow: hidden;")
		.bloom-canvas-element.bloom-backgroundImage(style="width:100%; height:100%;")
			.bloom-imageContainer
				img(src="placeHolder.png")
		block

html
	head
		+metadata-standard
		meta(name='bloomBookId', content='94AA1CB6-067C-45EB-A7E4-4D6496BA3D05')
		meta(name='canChangeOriginalAcknowledgments', content='false')
		meta(name='defaultBookletLayout', content='Calendar')
		meta(name='pageTemplateSource', content='Wall Calendar')
		meta(name='experimental', content='true')
		title Calendar
		+stylesheets('wallCalendar.css')
		//- The named styles used by the Calendar Month Grid page. They start out here so
		//- that a book made from this template, or a page inserted into some other book,
		//- gets sensible sizes before anyone opens the Format dialog.
		+standardStyles
			= '\n'
			| .CalendarMonth-style { font-size: 30pt !important; text-align: center !important; }
			= '\n'
			| .CalendarDayOfWeek-style { font-size: 12pt !important; font-weight: bold !important; text-align: center !important; }
			= '\n'
			| .CalendarDayNumber-style { font-size: 14pt !important; font-style: italic !important; }
			= '\n'
			| .CalendarDayNote-style { font-size: 9pt !important; }
		+script('jquery-1.10.1.js')
		+script('configure.js')
	body
		+dataDiv
			+bookVariable-title('en', 'Wall Calendar')
			+bookVariable-title('tpi', 'Kalenda')
			+bookVariable-title('id', 'Kalender')
		+preview-outsideFrontCover
		.bloom-page.calendarMonthTop.templateOnly.bloom-monolingual.bloom-content1.A5Landscape#3e049bff-797f-4a17-9c06-064955ae73cc(data-page='required spread-start')
			.marginBox
				+image-largePage
				+field-classOnChild('calendarPictureCaption-style').calendarBelowBigPictureText
					label.placeholder some nice text for the month
		.bloom-page.calendarMonthBottom.templateOnly.bloom-monolingual.bloom-content1.A5Landscape#553165c2-be6c-4cf2-885e-d8f3159170fe(data-page='required')
			.marginBox
				p(class='centered calendarBottomPageHeader') January 2099
				table
					thead
						tr
							th Sun
							th Mon
							th Tue
							th Wed
							th Thu
							th Fri
							th Sat
					tbody
						tr
							td
								.bloom-content1 1
							// NB: the actual contents are created by javascript. This first line has been modified to remind us what the javascript actually enters
							td 2
							td 3
							td 4
							td 5
							td 6
							td 7
						tr
							td 8
							td 9
							td 10
							td 11
							td 12
							td 13
							td 14
						tr
							td 15
							td 16
							td 17
							td 18
							td 19
							td 20
							td 21
						tr
							td 22
							td 23
							td 24
							td 25
							td 26
							td 27
							td 28
						tr
							td 29
							td 30
							td 31
							td
							td
							td
							td

		//- A modern, static January 2027 month grid. Unlike the two templateOnly pages above,
		//- this page's content is authored here rather than generated by configure.js, and it
		//- is data-page='extra', so the wizard (which expects exactly its two templateOnly
		//- pages) never sees it: BookStarter strips 'extra' pages at book creation, which
		//- leaves this page reachable only through Add Page.
		//- The whole page is one bloom-table (title row, weekday row, six day rows) sitting
		//- directly in the marginBox as the origami container. All sizing is in 'fill'/'hug'
		//- tokens, so the grid adapts to every landscape page size with no rescaling.
		//- bloom-table keeps the borders on the table, not on the cells (see the header comment
		//- of standardPage-AlphabetBook in standard-page-mixins.pug): data-edges-v is one entry
		//- per table row, each with eight entries for the seven columns' left and right
		//- boundaries (entry 0 is the left edge of the table, entry 7 the right); data-edges-h
		//- is nine boundaries of seven entries, one per column (boundary 0 is the top of the
		//- table, boundary 8 the bottom). Every entry is explicit, because an empty entry falls
		//- back to the table default and would draw a line we don't want.
		-
			var kCalendarColumnCount = 7;
			var kCalendarDayRowCount = 6;
			//- January 2027 begins on a Friday (Sunday = 0) and has 31 days, so day 31 sits
			//- alone in column 0 of the last row.
			var kCalendarFirstWeekdayIndex = 5;
			var kCalendarDaysInMonth = 31;
			var kCalendarWeekdayNames = ['Sun', 'Mon', 'Tues', 'Wed', 'Thur', 'Fri', 'Sat'];
			var kLine = { weight: 1, style: 'solid', color: '#000' };
			var kNone = { weight: 0, style: 'none', color: '#000' };
			var calendarDays = [];
			for (var i = 0; i < kCalendarColumnCount * kCalendarDayRowCount; i++) {
				var day = i - kCalendarFirstWeekdayIndex + 1;
				calendarDays.push({ day: day, used: day >= 1 && day <= kCalendarDaysInMonth, trailing: day > kCalendarDaysInMonth });
			}
			//- The title and weekday rows have no vertical lines at all; the day rows are fully
			//- boxed, except that the last row draws only around day 31, leaving the unused
			//- remainder of the month open (no interior lines and no perimeter).
			var calendarEdgesV = [];
			calendarEdgesV.push(Array(kCalendarColumnCount + 1).fill(kNone));
			calendarEdgesV.push(Array(kCalendarColumnCount + 1).fill(kNone));
			for (var row = 0; row < kCalendarDayRowCount - 1; row++)
				calendarEdgesV.push(Array(kCalendarColumnCount + 1).fill(kLine));
			calendarEdgesV.push([kLine, kLine].concat(Array(kCalendarColumnCount - 1).fill(kNone)));
			//- Horizontally: nothing above or below the title, then a line along the top of the
			//- grid and between every pair of day rows; the bottom of the table is drawn only
			//- under day 31.
			var calendarEdgesH = [];
			calendarEdgesH.push(Array(kCalendarColumnCount).fill(kNone));
			calendarEdgesH.push(Array(kCalendarColumnCount).fill(kNone));
			for (var boundary = 0; boundary < kCalendarDayRowCount; boundary++)
				calendarEdgesH.push(Array(kCalendarColumnCount).fill(kLine));
			calendarEdgesH.push([kLine].concat(Array(kCalendarColumnCount - 1).fill(kNone)));
			//- The same grid tracks bloom-table's render() computes for these tokens
			//- (table-renderer.ts: 'fill' = minmax(60px,1fr), 'hug' = minmax(20px,max-content)),
			//- authored inline so the page lays out with no JavaScript, e.g. in the Add Page
			//- thumbnail and in publish previews.
			var calendarGridStyle = 'grid-template-columns: ' + Array(kCalendarColumnCount).fill('minmax(60px,1fr)').join(' ') + '; grid-template-rows: minmax(20px,max-content) minmax(20px,max-content) ' + Array(kCalendarDayRowCount).fill('minmax(20px,1fr)').join(' ') + ';';
		+page('Calendar Month Grid', 'A month of days in a grid.')(data-page='extra').calendarMonthGrid#adff8f90-4b9b-4a32-92b5-f138c4fc4ffb
			.split-pane-component-inner
				.bloom-table(data-column-widths=Array(kCalendarColumnCount).fill('fill').join(','), data-row-heights='hug,hug,' + Array(kCalendarDayRowCount).fill('fill').join(','), data-edges-v=calendarEdgesV, data-edges-h=calendarEdgesH, style=calendarGridStyle)
					//- Title row: one cell spanning all seven columns, followed by the six
					//- 'skip' cells the span model requires (bloom-table.css hides them).
					.bloom-cell(data-content-type='text', data-span-x='7', style='--span-x: 7')
						+field-withEnglishText.CalendarMonth-style
							| January 2027
					each column in Array(kCalendarColumnCount - 1).fill(0)
						.bloom-cell.bloom-skip
					//- Weekday row
					each weekdayName in kCalendarWeekdayNames
						.bloom-cell(data-content-type='text')
							+field-withEnglishText.CalendarDayOfWeek-style
								= weekdayName
					//- Six rows of day cells. The day number is a plain, non-editable div, never
					//- inside a translationGroup, so TranslationGroupManager leaves it alone;
					//- bloom-styleable and tabindex are what let the user open the Format dialog
					//- on it. The notes field below it replaces the old <textarea>.
					each entry in calendarDays
						.bloom-cell.calendarDayCell(class=(entry.trailing ? 'calendarUnusedDay' : null), data-content-type='text', data-pad='0')
							.calendarDayCellContents
								if entry.used
									.calendarDayNumber.CalendarDayNumber-style.bloom-styleable(tabindex='0')= entry.day
								+field('auto').CalendarDayNote-style
