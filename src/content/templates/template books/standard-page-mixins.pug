include ../bloom-foundation-mixins
include preview-xmatter-mixins.pug

- const kImageOnLeftId = '7b192144-527c-417c-a2cb-1fb5e78bf38a';

mixin standardStyles
  style(type="text/css" title="userModifiedStyles")
    = '\n'
    | .BigWords-style { font-size: 45pt !important; text-align: center !important; }
    block

mixin videox
   +video.bloom-leadingElement&attributes(attributes)
mixin imagex
   +image.bloom-leadingElement&attributes(attributes)
mixin fieldx
   +field("auto").bloom-trailingElement.normal-style&attributes(attributes)

//- The 'percent' parameter is inscrutable. Why does it need to be the same for both
//- 'upper' and 'lower' mixins on the same page? What does it represent exactly?
//- Solution: Set a custom page the way you want it and go look at the numbers Bloom
//- puts there.
mixin upper(percent)
   - requireOneArgument('percent', arguments);
   .split-pane-component.position-top(style='bottom: ' + percent + '%')
      .split-pane-component-inner
         block
   .split-pane-divider.horizontal-divider(style='bottom: ' + percent + '%')
   //- NB: this split percent has to be the same as that used for upper!!!!!!

mixin lower(percent)
   - requireOneArgument('percent', arguments);
   .split-pane-component.position-bottom(style='height: ' + percent + '%')
      .split-pane-component-inner
         block

mixin stack
   .split-pane.horizontal-percent
      block
      .split-pane-resize-shim

mixin left
   .split-pane-component.position-left
      .split-pane-component-inner(min-height="60px 150px 250px" min-width="60px 150px" style="position: relative;")
         block
   .split-pane-divider.vertical-divider

mixin right
   .split-pane-component.position-right
      .split-pane-component-inner(min-height="60px 150px 250px" min-width="60px 150px" style="position: relative;")
         block

mixin stackLeftRight
   .split-pane.vertical-percent
      block
      .split-pane-resize-shim

mixin standardPage-JustText
   +page-choice('Just Text').customPage#a31c38d8-c1cb-4eb9-951b-d2840f6a8bdb&attributes(attributes)
      .split-pane-component-inner
         +fieldx

mixin standardPage-JustPicture
   +page-choice('Just an Image').customPage#adcd48df-e9ab-4a07-afd4-6a24d0398385&attributes(attributes)
      .split-pane-component-inner
         +image

mixin standardPage-JustVideo
   +page-choice('Just Video').customPage#8bedcdf8-3ad6-4967-b027-6c186436572f&attributes(attributes)
      .split-pane-component-inner
         +videox

mixin standardPage-Custom
   +page-choice-layout('Custom','A blank page that allows you to add items.').customPage#5dcd48df-e9ab-4a07-afd4-6a24d0398386&attributes(attributes)
      .split-pane-component-inner


//- An origami fold with a Heading 1 text block across the top (for the chart's title)
//- and, below it, a bloom-table of letters and pictures: nine rows, each holding three pairs of
//- a letter cell and the picture of a word that starts with it. Every row and every
//- picture column is "fill", so the chart spreads over whatever page size the book
//- uses; the letter columns "hug", which holds them to the 60px minimum a column can
//- take and leaves the rest of the width to the pictures.
//- bloom-table keeps the borders on the table, not on the cells: data-edges-v is
//- one row per table row, each with seven entries for the six columns' left and
//- right boundaries (entry 0 is the left edge of the table, entry 6 the right);
//- data-edges-h is ten boundaries of six entries, one per column (boundary 0 is
//- the top of the table, boundary 9 the bottom). An entry with a weight applies
//- to both sides of the boundary; west/east and north/south set one side only.
mixin standardPage-AlphabetBook
   -
      var kAlphabetRowCount = 9;
      var kAlphabetPairsPerRow = 3;
      var kLine = { weight: 1, style: 'solid', color: '#000' };
      var kNoLine = { weight: 0, style: 'none', color: '#000' };
      //- A letter cell is boxed; the picture beside it is not. So the boundary
      //- between a letter and the picture on its right draws on the letter's
      //- side only, and the picture columns draw nothing.
      var alphabetEdgesV = [];
      var alphabetEdgesH = [];
      for (var row = 0; row < kAlphabetRowCount; row++)
         alphabetEdgesV.push([{}, { west: kLine, east: kNoLine }, kLine, kLine, kLine, kLine, kNoLine]);
      for (var boundary = 0; boundary <= kAlphabetRowCount; boundary++)
         alphabetEdgesH.push([{}, kNoLine, kLine, kNoLine, kLine, kNoLine]);
   +page-choice('Alphabet Book', 'A letter of the alphabet and a picture, three pairs to a row.').customPage#beead98f-0fd2-4872-a364-2f14fa08d27b(data-feature='table')&attributes(attributes)
      +stack
         +upper(90)
            +field("auto").Heading1-style
         +lower(90)
            .bloom-table.bloom-leadingElement(data-column-widths='hug,fill,hug,fill,hug,fill', data-row-heights=Array(kAlphabetRowCount).fill('fill').join(','), data-gap-y='8px', data-edges-v=alphabetEdgesV, data-edges-h=alphabetEdgesH)
               each row in Array(kAlphabetRowCount).fill(0)
                  each pair in Array(kAlphabetPairsPerRow).fill(0)
                     .bloom-cell(data-content-type='text', data-corners='{"radius":4}')
                        +fieldx
                     .bloom-cell(data-content-type='image')
                        +image


//- Shared contents for pages that use the Canvas tool.
//- Allows callers to optionally insert additional .bloom-canvas-element items.
mixin canvasPageContents
  .split-pane-component-inner
    .bloom-canvas.bloom-has-canvas-element(data-tool-id="canvas")
      if block
        block
      .bloom-canvas-element.bloom-backgroundImage(style="width:100%; height:100%;")
        .bloom-imageContainer(data-tool-id="canvas")
          img(src="placeHolder.png")


//- The following list all the pages in Basic Book, Decodable Reader, & Leveled Reader
mixin include-standard-pages
   +page-splittable-choice-custom('Basic Text & Image')#adcd48df-e9ab-4a07-afd4-6a24d0398382&attributes(attributes)
     +stack
       +upper(50)
         +imagex
       +lower(50)
         +fieldx
   +page-splittable-choice-custom('Image in Middle')#adcd48df-e9ab-4a07-afd4-6a24d0398383&attributes(attributes)
     +stack
       +upper(76)
         +fieldx
       +lower(76)
         +stack
           +upper(30)
             +imagex
           +lower(30)
             +fieldx
   +page-splittable-choice-custom('Bilingual & Image in Middle', 'A page with one language above the image and another below it.')#adcd48df-e9ab-4a07-afd4-6a24d039838A(data-ui-mark-bilingual='true')&attributes(attributes)
     +stack
       +upper(76)
         +field("V")
       +lower(76)
         +stack
           +upper(30)
             +imagex
           +lower(30)
             +field("N1")
   +page-splittable-choice-custom('Image on Bottom')#adcd48df-e9ab-4a07-afd4-6a24d0398384&attributes(attributes)
     +stack
       +upper(50)
         +fieldx
       +lower(50)
         +image
   +page-splittable-choice-custom('Image on Left', 'For use with Landscape orientation.')(id=kImageOnLeftId)&attributes(attributes)
     +stackLeftRight
       +left
         +imagex
       +right
         +fieldx(class="bloom-vertical-align-center")
   +page-splittable-choice-custom('Image on Right', 'For use with Landscape orientation.')#b4879593-fcaa-4573-b107-0833f5dae49d&attributes(attributes).pictureOnRight
     +stackLeftRight
       +left
         +fieldx(class="bloom-vertical-align-center")
       +right
         +imagex
   +standardPage-JustPicture&attributes(attributes)
   +standardPage-JustText&attributes(attributes)

   +page-splittable-choice-custom('Canvas', 'A canvas...')#3d5adbdc-d42e-4b32-8032-04910cea0036(data-feature='canvas')
      +canvasPageContents

   +page-splittable-choice-custom('Image & Word', 'Page with an image on top and a large, centered word below.').customPage#aD115DFF-0415-4444-8E76-3D2A18DBBD27&attributes(attributes)
     +stack
       +upper(50)
         +imagex
       +lower(50)
         +field("auto").bloom-trailingElement.BigWords-style
   +standardPage-Custom&attributes(attributes)
