{
    "name": "component-tester",
    "private": true,
    "version": "0.0.0",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.13.0",
            "onFail": "download"
        }
    },
    "scripts": {
        "dev": "pnpm exec vite --config vite.config.ts --no-open",
        "test": "playwright test",
        "test:ui": "playwright test --ui --headed",
        "manual": "tsx scripts/manual.ts -- ",
        "manual:interactive": "playwright test --headed --timeout=0"
    },
    "dependencies": {
        "react": "18.3.1",
        "react-dom": "18.3.1"
    },
    "devDependencies": {
        "@playwright/test": "1.56.1",
        "@types/node": "24.13.0",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@vitejs/plugin-react": "4.7.0",
        "tsx": "4.20.6",
        "typescript": "6.0.3",
        "vite": "5.4.20"
    },
    "packageManager": "pnpm@11.5.2"
}
