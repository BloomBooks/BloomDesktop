doctype html
// OverflowFixture.html is generated from OverflowFixture.pug. Don't edit the .html file by hand; change the .pug and regenerate it.

//- This file is no longer directly used (was once imported by OverflowSpec.ts).
//- As of October 2025, getting Vite to import pug was problematic. I decided to
//- just check in the resulting html. Make changes here, then regenerate the .html by running this in src/BloomBrowserUI:
//-     pnpm exec pug --pretty bookEdit/OverflowChecker
//- Tests of overflow feature in Bloom that puts a red background in a field if there's too much content
//- Turns out the thing that made Story Primer always overflow was "overflow: visible" in the css
//- It always seemed to have scrollHeight = clientHeight + 2
//- NB: Could this have been the thin gray border of a focused entry box?
//- As a consequence, the overflow test will be "var overflow = scrollHeight > clientHeight + 2;
mixin testTarget
	.myTest&attributes(attributes)
		block

mixin standardTestField
	+testTarget.bloom-editable.bloom-content1(lang='z', contenteditable='true')&attributes(attributes)
		block

mixin standardTranslationGroup
	.bloom-translationGroup
		.bloom-editable.bloom-content1(lang='z', contenteditable='true')&attributes(attributes)
			block

head
body
	// Test#0
	+standardTestField(name="Default font bloom-editable with no styles doesn't overflow") Test texty

	// Test#1
	-var styles="font-family:Arial; font-size:x-large;height:18px;";
	+standardTestField(name="Arial bloom-editable with x-large text and small height should overflow", style=styles).expectToOverflow Test texty

	// Test#2
	-var styles="font-size:20pt;height:21px;overflow:visible";
	+standardTestField(name="Default font bloom-editable with large text and small height should overflow", style=styles).expectToOverflow Test texty

	// Test#3
	-var styles="font-family:Arial;";
	+standardTestField(name="Arial bloom-editable with no other styles should not overflow", style=styles) Test texty

	// Test#4
	-var styles="font-family:Arial; height:50px;";
	+standardTestField(name="Arial bloom-editable with fixed height should not overflow", style=styles) Test texty

	// Test#5
	-var styles="font-family:Arial; padding: 2px;";
	+standardTestField(name="Arial bloom-editable with only some padding should not overflow", style=styles) Test texty

	// Test#6 (BL-6338): Bloom's auto-sizing fits some boxes (canvas text boxes, the cover title) to the
	// visible text, leaving out room below the baseline that the font reserves but this text doesn't use.
	// Cutting off only that empty space is not overflow.
	-var styles="font-family:Arial; font-size:20px; height:20px;";
	+standardTestField(name="Arial text with no descenders doesn't overflow when only unused descent space is cut off", style=styles) summer

	// Test#7: the same box, but the text has descenders, and they are cut off.
	-var styles="font-family:Arial; font-size:20px; height:20px;";
	+standardTestField(name="Arial text whose descenders are cut off should overflow", style=styles).expectToOverflow happy puppy
