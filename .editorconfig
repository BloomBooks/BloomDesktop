root = true

# Defaults
[*]
trim_trailing_whitespace = true
insert_final_newline = true
//charset = utf-8 (due to VS2017 bug)
indent_size = 4

[*.{csproj,sln}]
indent_style = tab

[*.pug]
indent_style = tab

[*.{ts,json,js,md,jsx,css,less}]
indent_style = space

[*.{tmx,xlf}]
indent_style = space
indent_size = 2

[*.sh]
end_of_line = lf

[*.proj]
indent_style = space
indent_size = 2

[ReleaseNotes.md]
trim_trailing_whitespace=false

[*.cs]
# Culture-sensitive string searches (IndexOf, StartsWith, EndsWith, Compare, ...) give wrong
# answers in some cultures; e.g. Thai collation ignores punctuation (BL-16932, BL-16934).
# Always pass a StringComparison.
dotnet_diagnostic.CA1310.severity = error

# Banned APIs (src/BloomExe/BannedSymbols.txt): Bloom runs in the invariant culture, and only
# UserCulture may read or set the process culture (BL-16981).
dotnet_diagnostic.RS0030.severity = error
